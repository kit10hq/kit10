{
	"name": "kit10",
	"version": "0.1.0-dev",
	"description": "Small kit for creating websites from almost anything.",
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"bin": "./dist/src/main.mjs",
	"exports": {
		".": {
			"types": "./dist/src/main.d.mts",
			"import": "./dist/src/main.mjs"
		},
		"./worker/client": "./dist/browser/workers/worker/client.mjs",
		"./worker/server": "./dist/browser/workers/worker/server.mjs",
		"./service-worker/client": "./dist/browser/workers/service-worker/client.mjs",
		"./service-worker/server": "./dist/browser/workers/service-worker/server.mjs",
		"./hono": "./dist/src/reexports/hono.mjs",
		"./ws": "./dist/src/reexports/ws.mjs"
	},
	"engines": {
		"node": ">=22.16"
	},
	"dependencies": {
		"@hono/node-server": "2.0.4",
		"@minify-html/node": "0.18.1",
		"browserslist": "4.28.2",
		"esbuild": "0.28.0",
		"get-tsconfig": "4.14.0",
		"hono": "4.12.23",
		"html-rewriter-wasm": "0.4.1",
		"lightningcss": "1.32.0",
		"nanoid": "5.1.11",
		"neoevents": "0.3.0",
		"oxc-parser": "0.133.0",
		"valibot": "1.4.1",
		"ws": "8.21.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.10",
		"@kirick/lint": "0.3.2",
		"@types/node": "22.15.13",
		"@types/serviceworker": "0.0.197",
		"@types/ws": "8.18.1",
		"eslint": "10.2.0",
		"oxlint": "1.58.0",
		"publint": "0.3.21",
		"tsdown": "0.22.0",
		"type-fest": "5.7.0",
		"typescript": "6.0.2",
		"unplugin-unused": "0.5.7"
	},
	"scripts": {
		"build": "tsdown browser/workers/worker/client.ts browser/workers/worker/server.ts browser/workers/service-worker/client.ts browser/workers/service-worker/server.ts src/main.ts src/reexports/hono.ts src/reexports/ws.ts --unused --dts --format esm",
		"check": "bun run lint && bun run build",
		"lint": "biome format && oxlint && eslint . && tsc",
		"pack": "bun run check && dev pack create"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kit10hq/kit10.git"
	},
	"keywords": [],
	"author": "Daniil Kirichenko (https://twitter.com/kirickme)",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/kit10hq/kit10/issues"
	},
	"homepage": "https://github.com/kit10hq/kit10#readme"
}
