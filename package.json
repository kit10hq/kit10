{
	"name": "kit10",
	"version": "0.1.0-dev",
	"description": "Small kit for creating websites from almost anything.",
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"bin": "./dist/main.mjs",
	"types": "./dist/main.d.mts",
	"main": "./dist/main.mjs",
	"engines": {
		"node": ">=22.16"
	},
	"dependencies": {
		"@minify-html/node": "0.18.1",
		"browserslist": "4.28.2",
		"esbuild": "0.28.0",
		"html-rewriter-wasm": "0.4.1",
		"lightningcss": "1.32.0",
		"nanoid": "5.1.11"
	},
	"optionalDependencies": {
		"@hono/node-server": "2.0.4",
		"hono": "4.12.23"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.10",
		"@kirick/lint": "0.3.1",
		"@types/node": "22.15.13",
		"eslint": "10.2.0",
		"oxlint": "1.58.0",
		"publint": "0.3.21",
		"tsdown": "0.22.0",
		"typescript": "6.0.2",
		"unplugin-unused": "0.5.7"
	},
	"scripts": {
		"build": "tsdown src/main.ts --unused --dts --format esm",
		"check": "bun run lint && bun run build && bun run test",
		"lint": "biome format && oxlint && eslint . && tsc",
		"pack": "bun run check && dev pack create",
		"test": "echo 'No tests specified'"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kit10hq/kit10.git"
	},
	"keywords": [],
	"author": "Daniil Kirichenko (https://twitter.com/kirickme)",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/kit10hq/kit10/issues"
	},
	"homepage": "https://github.com/kit10hq/kit10#readme"
}
