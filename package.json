{
	"name": "kit10",
	"version": "0.1.0-dev",
	"description": "Small kit for creating websites from almost anything.",
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"main": "dist/main.js",
	"types": "dist/main.d.ts",
	"exports": {
		".": {
			"import": "./dist/main.js",
			"require": "./dist/main.cjs"
		}
	},
	"engines": {
		"node": ">=22.16"
	},
	"dependencies": {
		"esbuild": "0.28.0",
		"valibot": "1.4.1"
	},
	"optionalDependencies": {
		"@hono/node-server": "2.0.4",
		"hono": "4.12.23"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.10",
		"@kirick/lint": "0.3.0",
		"@types/node": "22.15.13",
		"@types/bun": "1.3.11",
		"eslint": "10.2.0",
		"oxlint": "1.58.0",
		"publint": "0.3.21",
		"tsdown": "0.22.0",
		"typescript": "6.0.2",
		"unplugin-unused": "0.5.7",
		"vitest": "4.1.7"
	},
	"scripts": {
		"build": "tsdown src/main.ts --unused --dts --format esm",
		"check": "bun run lint && bun run build && bun run test",
		"lint": "biome format && oxlint && eslint . && tsc && (cd test && tsc)",
		"test": "# npm run test:vitest && bun test --coverage",
		"test:vitest": "vitest run --no-file-parallelism"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kirick-ts/kit10.git"
	},
	"keywords": [],
	"author": "Daniil Kirichenko (https://twitter.com/kirickme)",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/kirick-ts/kit10/issues"
	},
	"homepage": "https://github.com/kirick-ts/kit10#readme"
}
